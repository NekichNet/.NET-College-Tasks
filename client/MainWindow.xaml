<Window x:Class="_19_12_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_19_12_App"
        mc:Ignorable="d"
        Title="Сотрудники" Height="600" Width="500">
    <Grid Margin="30 10">
        <Grid.RowDefinitions>
            <RowDefinition MaxHeight="50"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Button x:Name="UpdateButton" Grid.Row="0" Margin="3">Обновить список</Button>
        <ListBox x:Name="MainListBox" Grid.Row="1" Margin="3">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Path=Fullname}"></TextBlock>
                        <TextBlock Text="{Binding Path=PhoneNumber}"></TextBlock>
                        <TextBlock Text="{Binding Path=Email}"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
