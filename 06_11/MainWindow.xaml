<Window x:Class="_06_11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_06_11"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <ProgressBar Name="FirstBar" MaxHeight="150" MaxWidth="180" Grid.Row="0" Grid.Column="0"></ProgressBar>
        <ProgressBar Name="SecondBar" MaxHeight="150" MaxWidth="180" Grid.Row="0" Grid.Column="1"></ProgressBar>
        <ProgressBar Name="ThirdBar" MaxHeight="150" MaxWidth="180" Grid.Row="0" Grid.Column="2"></ProgressBar>
        <TextBlock Name="OutputText" Grid.Row="0" Grid.Column="3"></TextBlock>
        <Button Name="StandartButton" MaxHeight="150" MaxWidth="180" Grid.Row="1" Grid.Column="0">Standart</Button>
        <Button Name="DynamicButton" MaxHeight="150" MaxWidth="180" Grid.Row="1" Grid.Column="1">Dynamic priority</Button>
        <Button Name="ErrorButton" MaxHeight="150" MaxWidth="180" Grid.Row="1" Grid.Column="2">Error</Button>
        <Button Name="ThreesomeButton" MaxHeight="150" MaxWidth="180" Grid.Row="1" Grid.Column="3">Threesome</Button>
    </Grid>
</Window>
